	partition DimDate = calculated
		mode: import
		source = ```
				
				VAR DateMin = MIN(TTS[startdate])
				VAR DateMax = 
				    MAXX(
				        UNION(
				            SELECTCOLUMNS(TTS, "date", TTS[startdate]),
				            SELECTCOLUMNS(mv_retour_actif_prepaid, "date", mv_retour_actif_prepaid[jour]),
				            SELECTCOLUMNS(mv_retour_actif_postpaid, "date", mv_retour_actif_postpaid[jour]),
				            SELECTCOLUMNS(mv_retour_actif_recla_prepaid, "date", mv_retour_actif_recla_prepaid[jour]),
				            SELECTCOLUMNS(mv_retour_actif_recla_postpaid, "date", mv_retour_actif_recla_postpaid[jour]),
				            SELECTCOLUMNS(RECLAMATIONS, "date", RECLAMATIONS[startdate])
				        ),
				        [date]
				    )
				RETURN
				GENERATE(
				    CALENDAR(DateMin, DateMax),
				    VAR An = YEAR([Date])
				    VAR Semestre = IF(QUARTER([Date])<3,"S1","S2")
				    VAR Trimestre = "T"&QUARTER([Date])
				    VAR MoisLong = FORMAT([Date],"Mmmm")
				    VAR Mois = FORMAT([Date],"Mmm")
				    VAR Jour = FORMAT([Date],"dddd")
				    VAR NumMois = MONTH([Date])
				    VAR NumSemaine = WEEKNUM([Date],21)
				    VAR NumJourSem = WEEKDAY([Date],2)
				    VAR NumJourMois = DAY([Date])
				    RETURN ROW(
				        "Année", An,
				        "AnnéeSemestre", An&"-"&Semestre,
				        "AnnéeTrimestre", An&"-"&Trimestre,
				        "AnnéeMois", An&"-"&IF(NumMois<10,"0"&NumMois,NumMois),
				        "AnnéeSemaine", An&"-S"&NumSemaine,
				        "Semestre", Semestre,
				        "Trimestre", Trimestre,
				        "MoisLong", MoisLong,
				        "Mois", Mois,
				        "Semaine", "S "&NumSemaine,
				        "Jour", Jour,
				        "NumMois", NumMois,
				        "NumSemaine", NumSemaine,
				        "NumJourSemaine", NumJourSem,
				        "NumJourMois", NumJourMois
				    )
				)
				```

	annotation PBI_Id = 9071f44497af45749821e852fd53c003

